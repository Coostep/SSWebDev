<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments - Wild West Forum</title>
    <link rel="stylesheet" href="../../css/styles.css">
</head>
<body>
    <div class="container">
        {{> nav }}
        <main>
            <div class="comments-page">
                <h2>All Comments</h2>
                {{#if currentUser}}
                    <div class="new-comment-link">
                        <a href="/comment/new" class="btn btn-primary">Post New Comment</a>
                    </div>
                {{/if}}
                <div class="comments-list">
                    {{#each comments}}
                        <div class="comment-card">
                            <div class="comment-header">
                                <strong class="comment-author">{{this.author}}</strong>
                                <span class="comment-date">{{this.createdAt}}</span>
                            </div>
                            <div class="comment-text">{{{this.text}}}</div>
                        </div>
                    {{else}}
                        <div class="no-comments">
                            <p>No comments yet. Be the first to post!</p>
                        </div>
                    {{/each}}
                </div>
            </div>
        </main>
        {{> footer }}
    </div>
</body>
</html>
