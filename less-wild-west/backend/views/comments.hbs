<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Comments - Wild West Forum</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="container">
        {{> nav }}
        <main>
            <div class="comments-page">
                <h2>All Comments</h2>
                
                {{#if currentUser}}
                    <div class="new-comment-link">
                        <a href="/comments/new" class="btn btn-primary">Post New Comment</a>
                    </div>
                {{/if}}
                
                <div class="comments-list">
                    {{#each comments}}
                        <div class="comment-card">
                            <div class="comment-header">
                                <div class="comment-author">
                                    <span class="profile-icon">{{this.profile_icon}}</span>
                                    <strong style="color: {{this.profile_color}};">{{this.display_name}}</strong>
                                    <small>@{{this.username}}</small>
                                </div>
                                <div class="comment-meta">
                                    <span class="comment-date">{{this.created_at}}</span>
                                </div>
                            </div>
                            
                            <div class="comment-body">
                                <div class="comment-text">{{{this.text_html}}}</div>
                                
                                {{#if ../currentUser}}
                                    <div class="comment-actions">
                                        <a href="/comments/new?parentId={{this.id}}" class="reply-btn">Reply</a>
                                        
                                        {{#if this.isOwner}}
                                            <a href="/comments/{{this.id}}/edit" class="btn-edit">Edit</a>
                                            <button class="btn-delete" onclick="deleteComment('{{this.id}}')">Delete</button>
                                        {{/if}}
                                    </div>
                                {{/if}}
                            </div>
                        </div>
                    {{else}}
                        <div class="no-comments">
                            <p>No comments yet. Be the first to post!</p>
                        </div>
                    {{/each}}
                </div>
                
                <!-- Simple pagination without helpers -->
                <div class="simple-pagination">
                    {{#if pagination}}
                        {{#if pagination.hasPrev}}
                            <a href="/comments?page={{pagination.prevPage}}" class="btn btn-secondary">← Previous</a>
                        {{/if}}
                        
                        <span>Page {{pagination.page}} of {{pagination.totalPages}}</span>
                        
                        {{#if pagination.hasNext}}
                            <a href="/comments?page={{pagination.nextPage}}" class="btn btn-secondary">Next →</a>
                        {{/if}}
                    {{/if}}
                </div>
            </div>
        </main>
        {{> footer }}
    </div>
    
    <script>
        async function deleteComment(commentId) {
            if (confirm('Are you sure you want to delete this comment?')) {
                try {
                    const response = await fetch(`/comments/${commentId}/delete`, {
                        method: 'POST'
                    });
                    
                    const data = await response.json();
                    if (data.success) {
                        location.reload();
                    }
                } catch (error) {
                    console.error('Error deleting comment:', error);
                }
            }
        }
    </script>
</body>
</html>