<!--
    home.hbs
    The home page for the Less Wild West forum application.
-->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <div class="container">
        {{> nav }}
       
        <main>
            <div class="home-page">
                <div class="hero">
                    <h1>Welcome to the Secure Wild West Forum! 🤠🔒</h1>
                    <p class="subtitle">Now with proper security and real-time features</p>
                </div>

                <div class="features">
                    {{#each features}}
                        <div class="feature-card">
                            <h3>{{this}}</h3>
                            <p>Implemented with industry-standard security practices</p>
                        </div>
                    {{/each}}
                </div>

                <div class="stats">
                    <div class="stat-card">
                        <h3>📊 Database</h3>
                        <p>All data persists in SQLite3</p>
                    </div>
                    <div class="stat-card">
                        <h3>🔐 HTTPS</h3>
                        <p>Secure connections with Nginx Proxy Manager</p>
                    </div>
                    <div class="stat-card">
                        <h3>💬 Real-time</h3>
                        <p>Live chat powered by Socket.io</p>
                    </div>
                </div>

                <div class="cta">
                    {{#if currentUser}}
                        <a href="/comments" class="btn btn-primary">View Comments</a>
                        <a href="/chat" class="btn btn-secondary">Live Chat</a>
                        <a href="/profile" class="btn btn-primary">My Profile</a>
                    {{else}}
                        <a href="/register" class="btn btn-primary">Join Now</a>
                        <a href="/login" class="btn btn-secondary">Login</a>
                        <a href="/comments" class="btn btn-primary">Browse Comments</a>
                    {{/if}}
                </div>
            </div>
        </main>
       
        {{> footer }}
    </div>
</body>
</html>