<!--
    nav.hbs
    Navigation bar partial for the Wild West Forum application.
-->

<nav class="navbar">
    <div class="nav-brand">
        <h1>🤠 Wild West Forum</h1>
        <small>Secure Edition</small>
    </div>
    <div class="nav-links">
        <a href="/">Home</a>
        <a href="/comments">Comments</a>
        <a href="/chat">Live Chat</a>
        {{#if currentUser}}
            <span class="user-info" style="color: {{currentUser.color}};">
                {{currentUser.icon}} {{currentUser.displayName}}
            </span>
            <a href="/profile">Profile</a>
            <form action="/logout" method="POST" class="logout-form">
                <button type="submit">Logout</button>
            </form>
        {{else}}
            <a href="/register">Register</a>
            <a href="/login">Login</a>
        {{/if}}
    </div>
</nav>