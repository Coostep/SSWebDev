<!--
    This chat.hbs file is used to render the chat interface in the Less Wild West application.
    It includes the necessary HTML structure and Handlebars syntax to display chat messages.
-->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/styles.css">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body>
    <div class="container">
        {{ nav }}
        <main>
            <div class="chat-page">
                <h2>Live Chat</h2>
                <p class="subtitle">Real-time chat with all users</p>
                
                <div class="chat-container">
                    <div class="chat-sidebar">
                        <h3>Online Users</h3>
                        <div id="online-users" class="online-users">
                            <!-- Online users will be populated by JavaScript -->
                        </div>
                    </div>
                    
                    <div class="chat-main">
                        <div id="chat-messages" class="chat-messages">
                            {{#each messages}}
                                <div class="chat-message">
                                    <div class="message-header">
                                        <span class="profile-icon">{{this.profile_icon}}</span>
                                        <strong style="color: {{this.profile_color}};">{{this.display_name}}</strong>
                                        <small>@{{this.username}}</small>
                                        <span class="message-time">{{formatTime this.created_at}}</span>
                                    </div>
                                    <div class="message-content">{{this.message}}</div>
                                </div>
                            {{/each}}
                        </div>
                        
                        <div class="chat-input">
                            <form id="chat-form">
                                <input type="text" id="message-input" placeholder="Type your message..." autocomplete="off">
                                <button type="submit" class="btn btn-primary">Send</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
        {{ footer }}
    </div>
    
    <script>
        // Connect to Socket.IO
        const socket = io();
        
        // Get DOM elements
        const chatMessages = document.getElementById('chat-messages');
        const chatForm = document.getElementById('chat-form');
        const messageInput = document.getElementById('message-input');
        const onlineUsers = document.getElementById('online-users');
        
        // Handle incoming chat messages
        socket.on('chatMessage', (data) => {
            addMessage(data);
            scrollToBottom();
        });
        
        // Handle form submission
        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const message = messageInput.value.trim();
            
            if (message) {
                socket.emit('chatMessage', { message });
                messageInput.value = '';
            }
        });
        
        // Add message to chat
        function addMessage(data) {
            const messageElement = document.createElement('div');
            messageElement.className = 'chat-message';
            
            const time = new Date(data.timestamp).toLocaleTimeString([], { 
                hour: '2-digit', 
                minute: '2-digit' 
            });
            
            messageElement.innerHTML = `
                <div class="message-header">
                    <span class="profile-icon">${data.user.icon}</span>
                    <strong style="color: ${data.user.color};">${data.user.displayName}</strong>
                    <small>@${data.user.username}</small>
                    <span class="message-time">${time}</span>
                </div>
                <div class="message-content">${data.message}</div>
            `;
            
            chatMessages.appendChild(messageElement);
        }
        
        // Scroll to bottom of chat
        function scrollToBottom() {
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }
        
        // Initial scroll to bottom
        scrollToBottom();
        
        // Focus input on load
        messageInput.focus();
        
        // Load more messages when scrolling to top
        let loading = false;
        chatMessages.addEventListener('scroll', () => {
            if (chatMessages.scrollTop === 0 && !loading) {
                loading = true;
                // Load older messages
                const firstMessage = chatMessages.querySelector('.chat-message');
                if (firstMessage) {
                    // Implement pagination if needed
                }
                loading = false;
            }
        });
    </script>
</body>
</html>