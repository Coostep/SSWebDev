{{> header title=title}}

        <div class="container">
            <div class="page-header">
                <h1>About This Project</h1>
                <p>COS 498 Assignment 3: Secure PDF Server</p>
            </div>

            <div class="about-content">
                <section class="about-section">
                    <h2>Project Overview</h2>
                    <p>
                        This PDF Document Manager is developed as part of COS 498 - Advanced Web Development 
                        at the University of Maine. The project demonstrates secure file serving, custom module 
                        development, and modern web application architecture.
                    </p>
                </section>

                <section class="about-section">
                    <h2>Technical Features</h2>
                    <div class="features-grid">
                        <div class="feature-item">
                            <h3>Custom Modules</h3>
                            <ul>
                                <li><strong>Routing Module:</strong> Handles all URL routing and 404 errors</li>
                                <li><strong>PDF Discovery:</strong> Automatically scans and caches PDF files</li>
                                <li><strong>PDF Validation:</strong> Securely validates file access and permissions</li>
                                <li><strong>Database Module:</strong> Manages PDF metadata with SQLite3</li>
                            </ul>
                        </div>
                        <div class="feature-item">
                            <h3>Security Measures</h3>
                            <ul>
                                <li>HTTPS with SSL/TLS encryption</li>
                                <li>Path traversal attack prevention</li>
                                <li>File type validation</li>
                                <li>Secure download handling</li>
                                <li>Input sanitization</li>
                            </ul>
                        </div>
                        <div class="feature-item">
                            <h3>Architecture</h3>
                            <ul>
                                <li>Express.js web framework</li>
                                <li>Handlebars templating engine</li>
                                <li>SQLite3 database for metadata</li>
                                <li>Modular code structure</li>
                                <li>RESTful API endpoints</li>
                            </ul>
                        </div>
                    </div>
                </section>

                <section class="about-section">
                    <h2>Assignment Requirements</h2>
                    <div class="requirements-grid">
                        <div class="requirement fulfilled">
                            <h4>✅ Front-facing Website</h4>
                            <p>Professional interface with PDF listing and detailed views</p>
                        </div>
                        <div class="requirement fulfilled">
                            <h4>✅ PDF Document Management</h4>
                            <p>Secure PDF serving with validation and metadata storage</p>
                        </div>
                        <div class="requirement fulfilled">
                            <h4>✅ Domain & HTTPS</h4>
                            <p>Configured for secure domain access with SSL/TLS</p>
                        </div>
                        <div class="requirement fulfilled">
                            <h4>✅ Custom Modules</h4>
                            <p>Routing, PDF discovery, and validation modules</p>
                        </div>
                        <div class="requirement fulfilled">
                            <h4>✅ Database Storage</h4>
                            <p>SQLite3 database for PDF metadata with rich information</p>
                        </div>
                    </div>
                </section>

                <section class="about-section">
                    <h2>Setup & Installation</h2>
                    <div class="setup-steps">
                        <div class="step">
                            <h3>1. Installation</h3>
                            <code>npm install</code>
                        </div>
                        <div class="step">
                            <h3>2. Database Setup</h3>
                            <code>npm run init-db</code>
                        </div>
                        <div class="step">
                            <h3>3. Add PDF Files</h3>
                            <p>Place PDF files in the <code>pdfs/</code> directory</p>
                        </div>
                        <div class="step">
                            <h3>4. Start Server</h3>
                            <code>npm start</code>
                        </div>
                    </div>
                </section>
            </div>
        </div>

{{> footer}}
