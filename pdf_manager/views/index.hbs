{{> header title=title}}

        <section class="hero">
            <div class="container">
                <div class="hero-content">
                    <h1>Welcome to COS 498 PDF Manager</h1>
                    <p class="hero-subtitle">A secure document management system for course materials</p>
                    <p class="hero-description">
                        Access and manage all your course PDFs in one secure location. 
                        Find assignments, project guidelines, and study materials with ease.
                    </p>
                    <div class="hero-actions">
                        <a href="/library" class="btn btn-primary">Browse All PDFs</a>
                        <a href="/about" class="btn btn-secondary">Learn More</a>
                    </div>
                </div>
            </div>
        </section>

        <section class="features">
            <div class="container">
                <h2>System Features</h2>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">🔒</div>
                        <h3>Secure Access</h3>
                        <p>All PDFs are validated and served securely through custom modules with proper access controls.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">📚</div>
                        <h3>Organized Library</h3>
                        <p>Categorize and filter PDFs by type (Homework, Projects, Exams) for easy navigation.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">🔍</div>
                        <h3>Smart Discovery</h3>
                        <p>Automated PDF scanning and metadata management with caching for optimal performance.</p>
                    </div>
                </div>
            </div>
        </section>

        {{#if recentPDFs.length}}
        <section class="recent-pdfs">
            <div class="container">
                <h2>Recent Documents</h2>
                <div class="pdf-grid">
                    {{#each recentPDFs}}
                    <div class="pdf-card">
                        <div class="pdf-card-header">
                            <span class="pdf-category {{this.category}}">{{this.category}}</span>
                            {{#if this.assignment_number}}
                            <span class="pdf-assignment">Assignment {{this.assignment_number}}</span>
                            {{/if}}
                        </div>
                        <div class="pdf-card-body">
                            <h3>{{this.display_title}}</h3>
                            <p class="pdf-description">{{this.description}}</p>
                            <div class="pdf-meta">
                                {{#if this.due_date}}
                                <span class="due-date">Due: {{formatDate this.due_date}}</span>
                                {{/if}}
                            </div>
                        </div>
                        <div class="pdf-card-actions">
                            <a href="/pdf/{{this.id}}" class="btn btn-outline">View Details</a>
                            <a href="/download/{{this.filename}}" class="btn btn-primary">Download</a>
                        </div>
                    </div>
                    {{/each}}
                </div>
                <div class="section-actions">
                    <a href="/library" class="btn btn-secondary">View All Documents ({{totalPDFs}})</a>
                </div>
            </div>
        </section>
        {{/if}}

        <section class="stats">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-number">{{totalPDFs}}</div>
                        <div class="stat-label">Available Documents</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">3</div>
                        <div class="stat-label">Document Categories</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">100%</div>
                        <div class="stat-label">Secure Access</div>
                    </div>
                </div>
            </div>
        </section>

{{> footer}}
